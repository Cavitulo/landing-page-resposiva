<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matheus: Digital Strategy & Blueprint</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    
    <!-- Chosen Palette: Midnight Navy, Vibrant Coral, Clean Off-White -->
    <!-- Application Structure Plan: The SPA acts as a live, interactive prototype and strategy presentation of the Matheus brand brief. 
         Instead of reading a static document, stakeholders navigate a mock version of the site. 
         1. Hero: Demonstrates the 'bold, modern' vibe and immediate conversion focus. 
         2. Strategy & Data: Uses interactive charts to visualize the target audience (18-35 urban) and brand personality traits outlined in the brief, proving data-driven design.
         3. Interactive Product Flow: Implements the requested 'High-converting product page' structure via a dynamic modal, allowing users to experience the 'max 3 clicks to purchase' rule.
         This structure proves the brief's feasibility while simultaneously presenting its constraints. -->
    <!-- Visualization & Content Choices: 
         - Target Audience Breakdown -> Goal: Inform -> Viz: Doughnut Chart (Chart.js) -> Interaction: Hover tooltips -> Justification: Clearly shows the primary demographic focus (Young adults/Urban).
         - Brand Personality Mapping -> Goal: Compare -> Viz: Radar Chart (Chart.js) -> Interaction: Hover to see exact values -> Justification: Maps 'Bold, Modern, Energetic' against typical industry norms to show differentiation. 
         - E-commerce Flow -> Goal: Experience -> Viz: HTML/CSS Grid + JS Modal -> Interaction: Click to view details, Add to cart -> Justification: Directly answers the 'Product Page Structure' requirement interactively.
         Library: Chart.js (Canvas). CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->
    <!-- CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            navy: '#0A192F',
                            coral: '#FF6B6B',
                            light: '#F8F9FA',
                            dark: '#112240',
                            text: '#8892B0'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Montserrat', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Essential Chart Container Constraints */
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 600px; /* Constrain max width for readability */
            margin-left: auto;
            margin-right: auto;
            height: 300px; /* Responsive base height */
            max-height: 400px;
        }
        @media (min-width: 768px) {
            .chart-container { height: 350px; }
        }
        
        /* Custom UI Elements without SVG */
        .glass-nav {
            background: rgba(10, 25, 47, 0.85);
            backdrop-filter: blur(10px);
        }
        .btn-coral {
            background-color: #FF6B6B;
            color: white;
            transition: all 0.3s ease;
        }
        .btn-coral:hover {
            background-color: #ff5252;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -10px rgba(255, 107, 107, 0.5);
        }
        
        /* Simple Modal Animation */
        #product-modal { transition: opacity 0.3s ease; }
        .modal-content { transition: transform 0.3s ease; }
        .hidden-opacity { opacity: 0; pointer-events: none; }
        .visible-opacity { opacity: 1; pointer-events: auto; }
        .scale-in { transform: scale(1); }
        .scale-out { transform: scale(0.95); }

        /* Typography utility */
        .text-balance { text-wrap: balance; }
    </style>
</head>
<body class="bg-brand-light text-gray-800 font-sans antialiased overflow-x-hidden">

    <!-- Sticky Navigation -->
    <nav class="fixed w-full z-50 glass-nav border-b border-brand-dark transition-all duration-300" id="navbar">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <div class="flex-shrink-0 flex items-center">
                    <a href="#" class="font-heading font-black text-2xl tracking-tighter text-white uppercase">Matheus.</a>
                </div>
                <div class="hidden md:flex space-x-8">
                    <a href="#strategy" class="text-brand-light hover:text-brand-coral font-medium transition-colors">Strategy</a>
                    <a href="#shop" class="text-brand-light hover:text-brand-coral font-medium transition-colors">Prototype Shop</a>
                    <a href="#insights" class="text-brand-light hover:text-brand-coral font-medium transition-colors">Data Insights</a>
                </div>
                <div class="flex items-center space-x-4">
                    <button class="text-white hover:text-brand-coral relative group" onclick="toggleCartAlert()">
                        <span class="text-2xl">🛒</span>
                        <span id="cart-badge" class="absolute -top-1 -right-2 bg-brand-coral text-white text-xs font-bold px-1.5 py-0.5 rounded-full hidden">0</span>
                    </button>
                    <a href="#shop" class="hidden md:inline-flex items-center justify-center px-6 py-2 border border-transparent text-sm font-bold rounded-full btn-coral uppercase tracking-wide">
                        Shop Now
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Notification Toast -->
    <div id="toast" class="fixed top-24 right-4 bg-brand-navy text-white px-6 py-3 rounded shadow-lg transform transition-transform translate-x-full z-50 flex items-center gap-2">
        <span class="text-green-400">✓</span>
        <span id="toast-msg">Item added to cart</span>
    </div>

    <main>
        <!-- Hero Section -->
        <section id="hero" class="relative bg-brand-navy pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden flex items-center min-h-[90vh]">
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-coral via-brand-navy to-brand-navy"></div>
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center max-w-4xl mx-auto">
                    <span class="text-brand-coral font-bold tracking-widest uppercase text-sm mb-4 block">Project Blueprint & Prototype</span>
                    <h1 class="text-5xl md:text-7xl font-heading font-black text-white mb-6 uppercase tracking-tight leading-tight text-balance">
                        Bold. Modern.<br><span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-coral to-orange-400">Unapologetic.</span>
                    </h1>
                    <p class="mt-4 text-xl text-brand-text mb-10 max-w-2xl mx-auto">
                        This interactive document translates the Matheus website brief into a tangible experience. We are prioritizing conversion, premium aesthetics, and urban lifestyle appeal.
                    </p>
                    <div class="flex flex-col sm:flex-row justify-center gap-4">
                        <a href="#shop" class="btn-coral px-8 py-4 rounded-full font-bold text-lg uppercase tracking-wide flex items-center justify-center gap-2">
                            Explore Prototype <span>↓</span>
                        </a>
                        <a href="#strategy" class="px-8 py-4 rounded-full font-bold text-lg uppercase tracking-wide text-white border border-brand-text hover:border-white hover:bg-white/5 transition-all">
                            View Strategy Data
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Strategy Context Section -->
        <section id="strategy" class="py-20 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="mb-12 border-l-4 border-brand-coral pl-6">
                    <h2 class="text-3xl font-heading font-black text-brand-navy uppercase">Strategic Foundation</h2>
                    <p class="mt-4 text-gray-600 max-w-3xl">
                        To build a high-converting experience, we first analyze the target demographic defined in the brief: Urban adults aged 18-35. The visualizations below dictate our UX decisions, ensuring the site feels "energetic and aspirational."
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                    <!-- Chart 1 Container -->
                    <div class="bg-gray-50 rounded-2xl p-6 shadow-sm border border-gray-100">
                        <h3 class="text-xl font-bold text-center mb-2 font-heading">Target Audience Breakdown</h3>
                        <p class="text-sm text-center text-gray-500 mb-4">Core demographic focus for ad targeting</p>
                        <div class="chart-container">
                            <canvas id="audienceChart"></canvas>
                        </div>
                    </div>

                    <!-- Strategy Text -->
                    <div>
                        <ul class="space-y-8">
                            <li class="flex items-start">
                                <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 text-brand-coral text-2xl font-black">1</div>
                                <div class="ml-4">
                                    <h4 class="text-xl font-bold text-brand-navy">Mobile-First Priority</h4>
                                    <p class="mt-1 text-gray-600">With 75% of our target audience (Urban Millennials/Gen Z) browsing via mobile, the UI requires large touch targets, sticky carts, and fast load times.</p>
                                </div>
                            </li>
                            <li class="flex items-start">
                                <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 text-brand-coral text-2xl font-black">2</div>
                                <div class="ml-4">
                                    <h4 class="text-xl font-bold text-brand-navy">Visual Storytelling</h4>
                                    <p class="mt-1 text-gray-600">Replacing heavy text with "Lifestyle Visuals" as requested. The product must be shown in real-life, energetic situations.</p>
                                </div>
                            </li>
                            <li class="flex items-start">
                                <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 text-brand-coral text-2xl font-black">3</div>
                                <div class="ml-4">
                                    <h4 class="text-xl font-bold text-brand-navy">Frictionless Conversion</h4>
                                    <p class="mt-1 text-gray-600">Implementing the "max 3 clicks to purchase" rule. The prototype below demonstrates quick-add functionality.</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Prototype Shop Section -->
        <section id="shop" class="py-24 bg-brand-light">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <span class="text-brand-coral font-bold tracking-widest uppercase text-sm mb-2 block">The Experience</span>
                    <h2 class="text-4xl font-heading font-black text-brand-navy uppercase">Product Discovery</h2>
                    <p class="mt-4 text-gray-600 max-w-2xl mx-auto">
                        Interact with the product grid to test the high-converting UI structure. Notice the clear CTAs, premium layout, and urgency triggers designed for the Matheus brand.
                    </p>
                </div>

                <!-- Product Grid (Populated by JS) -->
                <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Cards injected here -->
                </div>
            </div>
        </section>

        <!-- Brand Data Insights -->
        <section id="insights" class="py-20 bg-brand-navy text-white">
             <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="mb-12 border-l-4 border-brand-coral pl-6">
                    <h2 class="text-3xl font-heading font-black uppercase text-white">Brand Positioning Analytics</h2>
                    <p class="mt-4 text-brand-text max-w-3xl">
                        How Matheus compares to traditional competitors in the beverage space. This data informs our copywriting tone (Bold, Energetic) and design language.
                    </p>
                </div>

                <div class="bg-brand-dark rounded-3xl p-6 lg:p-10 shadow-2xl">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
                        <div class="lg:col-span-1 space-y-6">
                            <div>
                                <h3 class="text-2xl font-bold text-white font-heading">The Differentiator</h3>
                                <p class="text-brand-text mt-2 text-sm leading-relaxed">
                                    Traditional brands focus on heritage. Matheus focuses on immediate energy and social connection. The UX design heavily indexes on features that promote sharing and impulse buying.
                                </p>
                            </div>
                            <div class="bg-brand-navy/50 p-4 rounded-xl border border-white/10">
                                <p class="text-xs uppercase tracking-wide text-brand-coral mb-1">Key Insight</p>
                                <p class="text-sm font-medium">Pricing strategy is positioned as "Premium Accessible" — higher perceived value without exclusionary pricing.</p>
                            </div>
                        </div>
                        <div class="lg:col-span-2">
                             <!-- Chart 2 Container -->
                            <div class="chart-container" style="max-width: 500px;">
                                <canvas id="brandRadarChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
             </div>
        </section>

        <!-- Social Proof & Lead Gen (Footer area) -->
        <section class="py-20 bg-brand-coral text-white text-center">
            <div class="max-w-3xl mx-auto px-4">
                <h2 class="text-4xl font-heading font-black uppercase mb-6">Join The Movement</h2>
                <p class="text-lg mb-8 opacity-90">Sign up for exclusive drops, event invites, and 15% off your first order. (Lead Capture Requirement)</p>
                <form onsubmit="event.preventDefault(); alert('Lead captured in database!');" class="flex flex-col sm:flex-row max-w-lg mx-auto gap-4">
                    <input type="email" placeholder="Enter your email" required class="flex-1 px-6 py-4 rounded-full text-brand-navy focus:outline-none focus:ring-2 focus:ring-white">
                    <button type="submit" class="bg-brand-navy text-white px-8 py-4 rounded-full font-bold uppercase tracking-wide hover:bg-gray-800 transition-colors">Subscribe</button>
                </form>
            </div>
        </section>
    </main>

    <footer class="bg-brand-navy border-t border-white/10 py-12 text-center">
        <p class="font-heading font-black text-2xl tracking-tighter text-white uppercase mb-4">Matheus.</p>
        <p class="text-brand-text text-sm">Interactive SPA Prototype based on provided design brief.</p>
    </footer>

    <!-- Product Detail Modal -->
    <div id="product-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden-opacity">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-brand-navy/80 backdrop-blur-sm" onclick="closeModal()"></div>
        
        <!-- Modal Content -->
        <div id="modal-content" class="relative bg-white rounded-2xl shadow-2xl w-full max-w-4xl mx-4 max-h-[90vh] overflow-y-auto scale-out flex flex-col md:flex-row">
            <button onclick="closeModal()" class="absolute top-4 right-4 text-gray-400 hover:text-brand-navy text-2xl z-10 w-8 h-8 flex items-center justify-center rounded-full bg-white shadow-md">
                ✕
            </button>
            
            <!-- Left: Visual (Simulated Image Area) -->
            <div class="w-full md:w-1/2 bg-gray-100 flex items-center justify-center p-12 min-h-[300px]" id="modal-visual-container">
                <!-- Dynamic color box simulating product shot -->
                <div id="modal-color-swatch" class="w-full h-full rounded-xl shadow-inner flex items-center justify-center flex-col gap-4 transition-colors duration-500">
                     <div class="text-6xl" id="modal-icon">🧊</div>
                     <span class="font-heading font-black text-white/50 text-2xl uppercase tracking-widest" id="modal-bg-text">MATHEUS</span>
                </div>
            </div>

            <!-- Right: Details (Conversion Structure) -->
            <div class="w-full md:w-1/2 p-8 lg:p-12 flex flex-col justify-center">
                <div class="flex justify-between items-start mb-2">
                    <span id="modal-category" class="text-brand-coral font-bold text-xs uppercase tracking-wider">Category</span>
                    <span class="bg-red-100 text-red-600 text-xs font-bold px-2 py-1 rounded">Limited Stock</span>
                </div>
                <h2 id="modal-title" class="text-3xl font-heading font-black text-brand-navy mb-2 uppercase">Product Name</h2>
                
                <div class="flex items-center gap-2 mb-4">
                    <span class="text-yellow-400 text-lg">★★★★★</span>
                    <span class="text-sm text-gray-500 underline cursor-pointer">(128 Reviews)</span>
                </div>

                <p id="modal-price" class="text-2xl font-bold text-gray-900 mb-6">$0.00</p>
                <p id="modal-desc" class="text-gray-600 mb-8 leading-relaxed">Product description goes here.</p>

                <!-- Urgency & CTA -->
                <div class="space-y-4">
                    <div class="flex items-center gap-4">
                        <div class="flex border border-gray-300 rounded-full overflow-hidden w-32">
                            <button class="w-10 h-10 flex items-center justify-center hover:bg-gray-100 font-bold text-xl" onclick="updateQty(-1)">-</button>
                            <input type="text" id="qty-input" value="1" class="w-12 text-center font-bold outline-none" readonly>
                            <button class="w-10 h-10 flex items-center justify-center hover:bg-gray-100 font-bold text-xl" onclick="updateQty(1)">+</button>
                        </div>
                        <button onclick="addToCartFromModal()" class="flex-1 btn-coral py-4 rounded-full font-bold uppercase tracking-wide flex items-center justify-center gap-2">
                            Add to Cart
                        </button>
                    </div>
                    <p class="text-xs text-center text-gray-500 flex items-center justify-center gap-1">
                        <span class="text-green-500">🔒</span> Secure Checkout | Free Urban Delivery
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- Data Architecture ---
        
        // Mock Product Data representing "Bold, modern, energetic" brand
        const products = [
            { 
                id: 1, 
                name: "Neon Citrus Burst", 
                category: "Energy Series",
                price: 24.99, 
                desc: "A high-voltage blend of yuzu, blood orange, and natural caffeine. Formulated for the night out. Premium ingredients, zero crash.",
                color: "bg-orange-500",
                icon: "🍊",
                tag: "Best Seller"
            },
            { 
                id: 2, 
                name: "Midnight Botanics", 
                category: "Lifestyle Mixer",
                price: 28.50, 
                desc: "Sophisticated dark berry fusion with adaptogens. Designed to be enjoyed solo or as a premium mixer. Smooth, complex, urban.",
                color: "bg-purple-800",
                icon: "🫐",
                tag: "New"
            },
            { 
                id: 3, 
                name: "Electric Lychee", 
                category: "Refresh Series",
                price: 22.00, 
                desc: "Crisp, sweet, and aggressively refreshing. The perfect daytime lifestyle companion. Served best ice cold.",
                color: "bg-pink-500",
                icon: "🧊",
                tag: ""
            }
        ];

        // State Management
        let cartCount = 0;
        let currentSelectedProduct = null;

        // --- UI Logic & Interaction ---

        // Navbar scroll effect
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('navbar');
            if (window.scrollY > 50) {
                nav.classList.add('shadow-lg');
            } else {
                nav.classList.remove('shadow-lg');
            }
        });

        // Toast Notification
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = message;
            toast.classList.remove('translate-x-full');
            setTimeout(() => {
                toast.classList.add('translate-x-full');
            }, 3000);
        }

        function toggleCartAlert() {
            if(cartCount === 0) {
                alert("Your cart is empty. Start exploring the products!");
            } else {
                alert(`Proceeding to checkout with ${cartCount} item(s). (Prototype feature)`);
            }
        }

        // Render Products to Grid
        function renderProducts() {
            const grid = document.getElementById('product-grid');
            grid.innerHTML = ''; // Clear

            products.forEach(product => {
                const tagHtml = product.tag ? `<div class="absolute top-4 left-4 bg-brand-navy text-white text-xs font-bold px-3 py-1 rounded uppercase tracking-wider z-10">${product.tag}</div>` : '';
                
                const card = `
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden group hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 relative cursor-pointer" onclick="openModal(${product.id})">
                        ${tagHtml}
                        <!-- Mock Image Area -->
                        <div class="h-64 ${product.color} relative overflow-hidden flex items-center justify-center transition-transform duration-700 group-hover:scale-105">
                            <div class="text-7xl drop-shadow-lg">${product.icon}</div>
                            <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-300"></div>
                        </div>
                        
                        <div class="p-6">
                            <div class="flex justify-between items-start mb-2">
                                <div>
                                    <p class="text-xs text-brand-coral font-bold uppercase tracking-wider mb-1">${product.category}</p>
                                    <h3 class="text-xl font-bold font-heading uppercase text-brand-navy group-hover:text-brand-coral transition-colors">${product.name}</h3>
                                </div>
                                <span class="text-lg font-bold text-gray-900">$${product.price.toFixed(2)}</span>
                            </div>
                            <p class="text-gray-500 text-sm line-clamp-2 mb-6">${product.desc}</p>
                            
                            <button class="w-full border-2 border-brand-navy text-brand-navy font-bold uppercase tracking-wide py-3 rounded-full group-hover:bg-brand-navy group-hover:text-white transition-all flex justify-center items-center gap-2">
                                View Details <span>→</span>
                            </button>
                        </div>
                    </div>
                `;
                grid.innerHTML += card;
            });
        }

        // --- Modal Logic ---
        const modal = document.getElementById('product-modal');
        const modalContent = document.getElementById('modal-content');
        
        function openModal(productId) {
            currentSelectedProduct = products.find(p => p.id === productId);
            if (!currentSelectedProduct) return;

            // Populate Data
            document.getElementById('modal-title').innerText = currentSelectedProduct.name;
            document.getElementById('modal-category').innerText = currentSelectedProduct.category;
            document.getElementById('modal-price').innerText = `$${currentSelectedProduct.price.toFixed(2)}`;
            document.getElementById('modal-desc').innerText = currentSelectedProduct.desc;
            document.getElementById('qty-input').value = 1;
            
            // Visual Update
            const swatch = document.getElementById('modal-color-swatch');
            swatch.className = `w-full h-full rounded-xl shadow-inner flex items-center justify-center flex-col gap-4 transition-colors duration-500 ${currentSelectedProduct.color}`;
            document.getElementById('modal-icon').innerText = currentSelectedProduct.icon;

            // Show Modal
            modal.classList.remove('hidden-opacity');
            modal.classList.add('visible-opacity');
            setTimeout(() => {
                modalContent.classList.remove('scale-out');
                modalContent.classList.add('scale-in');
            }, 10);
            
            // Prevent body scroll
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modalContent.classList.remove('scale-in');
            modalContent.classList.add('scale-out');
            setTimeout(() => {
                modal.classList.remove('visible-opacity');
                modal.classList.add('hidden-opacity');
                document.body.style.overflow = 'auto'; // Restore scroll
                currentSelectedProduct = null;
            }, 300);
        }

        function updateQty(change) {
            const input = document.getElementById('qty-input');
            let val = parseInt(input.value) + change;
            if (val < 1) val = 1;
            if (val > 10) val = 10;
            input.value = val;
        }

        function addToCartFromModal() {
            const qty = parseInt(document.getElementById('qty-input').value);
            cartCount += qty;
            
            // Update UI
            const badge = document.getElementById('cart-badge');
            badge.innerText = cartCount;
            badge.classList.remove('hidden');
            
            // Animate badge
            badge.classList.add('animate-bounce');
            setTimeout(() => badge.classList.remove('animate-bounce'), 1000);

            showToast(`Added ${qty}x ${currentSelectedProduct.name} to cart.`);
            closeModal();
        }


        // --- Data Visualization Logic (Chart.js) ---
        
        // Common Chart Options ensuring responsiveness within strict containers
        const commonOptions = {
            responsive: true,
            maintainAspectRatio: false, // Critical for custom container sizing
            plugins: {
                legend: { position: 'bottom', labels: { font: { family: 'Inter' } } },
                tooltip: { backgroundColor: 'rgba(10, 25, 47, 0.9)', titleFont: { family: 'Montserrat' } }
            }
        };

        function initCharts() {
            // Chart 1: Audience Breakdown (Doughnut)
            const ctxAudience = document.getElementById('audienceChart').getContext('2d');
            new Chart(ctxAudience, {
                type: 'doughnut',
                data: {
                    labels: ['Urban 18-25', 'Urban 26-35', 'Suburban 18-35', 'Other'],
                    datasets: [{
                        data: [45, 35, 15, 5],
                        backgroundColor: [
                            '#FF6B6B', // Coral (Core)
                            '#0A192F', // Navy
                            '#CBD5E1', // Light Gray
                            '#F1F5F9'
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 4
                    }]
                },
                options: {
                    ...commonOptions,
                    cutout: '70%', // Make it thin and modern
                    plugins: {
                        ...commonOptions.plugins,
                        title: { display: false }
                    }
                }
            });

            // Chart 2: Brand Positioning (Radar)
            const ctxRadar = document.getElementById('brandRadarChart').getContext('2d');
            new Chart(ctxRadar, {
                type: 'radar',
                data: {
                    labels: ['Boldness', 'Energy', 'Accessibility', 'Premium Feel', 'Tradition', 'Social Factor'],
                    datasets: [
                        {
                            label: 'Matheus Target',
                            data: [90, 95, 80, 85, 20, 90],
                            fill: true,
                            backgroundColor: 'rgba(255, 107, 107, 0.2)',
                            borderColor: '#FF6B6B',
                            pointBackgroundColor: '#FF6B6B',
                            pointBorderColor: '#fff',
                            pointHoverBackgroundColor: '#fff',
                            pointHoverBorderColor: '#FF6B6B'
                        },
                        {
                            label: 'Industry Average',
                            data: [50, 60, 65, 50, 80, 50],
                            fill: true,
                            backgroundColor: 'rgba(255, 255, 255, 0.1)',
                            borderColor: '#8892B0',
                            pointBackgroundColor: '#8892B0',
                            pointBorderColor: '#fff',
                            borderDash: [5, 5]
                        }
                    ]
                },
                options: {
                    ...commonOptions,
                    scales: {
                        r: {
                            angleLines: { color: 'rgba(255,255,255,0.1)' },
                            grid: { color: 'rgba(255,255,255,0.1)' },
                            pointLabels: { color: '#8892B0', font: { family: 'Montserrat', size: 11, weight: 'bold' } },
                            ticks: { display: false, min: 0, max: 100 } // Hide numbers for cleaner look
                        }
                    },
                    plugins: {
                         legend: {
                            position: 'top',
                            labels: { color: '#fff' }
                        }
                    }
                }
            });
        }

        // --- Initialization ---
        document.addEventListener('DOMContentLoaded', () => {
            renderProducts();
            initCharts();
        });

    </script>
</body>
</html>